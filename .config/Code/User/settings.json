{
  // editor
  "editor.accessibilitySupport": "off",
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Courier New', monospace",
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.guides.bracketPairs": "active",
  "editor.renderLineHighlight": "all",
  "editor.renderLineHighlightOnlyWhenFocus": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "explicit",
  // workbench
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.tabSizing": "fixed",
  "workbench.colorTheme": "Dark Modern",
  "workbench.panel.showLabels": false,
  // file
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // etc
  "debug.inlineValues": "on",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  // terminal
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "terminal.integrated.env.osx": {
    "Q_NEW_SESSION": "1"
  },
  "terminal.integrated.suggest.enabled": false,
  // git
  "git.confirmSync": false,
  // go
  "go.useLanguageServer": true,
  "gopls": {
    "formatting.gofumpt": true
  },
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--fast"
  ],
  "go.toolsManagement.autoUpdate": true,
  "go.diagnostic.vulncheck": "Imports",
  // Markdown
  "markdown-preview-github-styles.colorTheme": "light",
  "markdown-preview-enhanced.enablePreviewZenMode": false,
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  // drawio
  "hediet.vscode-drawio.resizeImages": null,
  "hediet.vscode-drawio.theme": "atlas",
  // codelens
  "diffEditor.codeLens": true,
  // gcp
  "google.cloud.project": "jimii-dev",
  "cloudcode.project": "jimii-dev",
  // gemini
  "geminicodeassist.project": "jimii-dev",
  "geminicodeassist.displayInlineContextHint": false,
  "claudeCode.useTerminal": true,
  "claudeCode.preferredLocation": "panel",
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
  },
  "http.systemCertificatesNode": true,
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "chat.viewSessions.orientation": "stacked",
}
