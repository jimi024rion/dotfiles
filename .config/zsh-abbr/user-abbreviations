#----------------------------------------------------------#
#  abbr                                                    #
#  コマンドショートカットの一元管理。                      #
#  展開後に編集できるため、危険なコマンドも安全に使える。  #
#----------------------------------------------------------#

#--- git ---
abbr g='git'
# add
abbr ga='git add'
abbr gaa='git add --all'
abbr gapa='git add --patch'
# branch
abbr gb='git branch'
abbr gba='git branch --all'
abbr gbd='git branch --delete'
abbr gbD='git branch --delete --force'
abbr ggsup='git branch --set-upstream-to=origin/$(git_current_branch)'
# commit
abbr gc='git commit --verbose'
abbr gcmsg='git commit --message "%"'
abbr gcm='git commit -m "%"'
abbr gcf='git config --list'
# checkout / switch
abbr gco='git checkout'
abbr gcb='git checkout -b "%"'
abbr gsw='git switch'
abbr gswc='git switch --create "%"'
# diff
abbr gd='git diff'
abbr gdca='git diff --cached'
abbr gdw='git diff --word-diff'
# fetch
abbr gf='git fetch'
abbr gfa='git fetch --all --prune'
abbr gfo='git fetch origin'
# pull / log
abbr gl='git pull'
abbr gpr='git pull --rebase'
abbr glog='git log --oneline --decorate --graph'
abbr gloga='git log --oneline --decorate --graph --all'
abbr glo='git log --oneline'
abbr glg='git log --graph'
# merge
abbr gm='git merge'
abbr gma='git merge --abort'
abbr gms='git merge --squash'
# push
abbr gp='git push'
abbr gpf='git push --force-with-lease'
abbr gpu='git push --set-upstream origin $(git_current_branch)'
# rebase
abbr grb='git rebase'
abbr grbi='git rebase --interactive'
abbr grbc='git rebase --continue'
abbr grba='git rebase --abort'
abbr grbs='git rebase --skip'
# reset
abbr grh='git reset'
abbr grhh='git reset --hard'
abbr grhs='git reset --soft'
# stash
abbr gsta='git stash push'
abbr gstaa='git stash apply'
abbr gstp='git stash pop'
abbr gstd='git stash drop'
abbr gstl='git stash list'
# status
abbr gst='git status'
abbr gss='git status --short'
abbr gsb='git status --short --branch'
# tag
abbr gt='git tag'
abbr gtv='git tag | sort -V'
# submodule
abbr gsi='git submodule init'
abbr gsu='git submodule update'
# worktree
abbr gwt='git worktree'
abbr gwta='git worktree add'
abbr gwtls='git worktree list'
abbr gwtrm='git worktree remove'

#--- docker ---
abbr d='docker'
abbr dps='docker ps'
abbr dpsa='docker ps -a'
abbr di='docker images'
abbr dex='docker exec -it "%"'
abbr dbl='docker build'
abbr drm='docker rm'
abbr drmi='docker rmi'
abbr dstop='docker stop'
abbr dlogs='docker logs'
abbr dlogsf='docker logs -f'
abbr dprune='docker system prune -f'
# docker compose（新形式: docker compose）
abbr dc='docker compose'
abbr dcu='docker compose up'
abbr dcud='docker compose up -d'
abbr dcd='docker compose down'
abbr dcr='docker compose restart'
abbr dcl='docker compose logs'
abbr dclf='docker compose logs -f'
abbr dcps='docker compose ps'
abbr dcb='docker compose build'

#--- terraform ---
abbr tf='terraform'
abbr tfi='terraform init'
abbr tfp='terraform plan'
abbr tfa='terraform apply'
abbr tfaa='terraform apply -auto-approve'
abbr tfd='terraform destroy'
abbr tfda='terraform destroy -auto-approve'
abbr tff='terraform fmt'
abbr tfv='terraform validate'
abbr tfo='terraform output'
abbr tfw='terraform workspace'
abbr tfsl='terraform state list'
abbr tfss='terraform state show'

#--- go ---
abbr gob='go build'
abbr got='go test'
abbr gotv='go test -v'
abbr gotc='go test -cover'
abbr gor='go run'
abbr goi='go install'
abbr gotidy='go mod tidy'
abbr govet='go vet'

#--- ナビゲーション ---
abbr ...='cd ../..'
abbr ....='cd ../../..'
abbr .....='cd ../../../..'
abbr ......='cd ../../../../..'
abbr ll='eza --group-directories-first --icons --git -l -I .git'
abbr la='eza --group-directories-first --icons -la --git -I .git'
abbr tree='eza --group-directories-first --icons -Ta --git -I .git'
abbr rmf='rm -fr'

#--- grep（グローバル略語: コマンド以外の位置でも展開） ---
abbr -g egrep='grep -E "%"'
abbr -g fgrep='grep -F "%"'
abbr hg='history | grep'

